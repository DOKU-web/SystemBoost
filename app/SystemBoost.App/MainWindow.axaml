<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="using:SystemBoost.App.Pages"
        x:Class="SystemBoost.App.MainWindow"
        Title="SystemBoost"
        Icon="/Assets/SystemBoost.ico"
        Width="1600" Height="1000" MinWidth="1280" MinHeight="800"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="236,*">
    <!-- sidebar -->
    <Border Grid.Column="0" Background="{StaticResource SbSide}" BorderBrush="{StaticResource SbLine}" BorderThickness="0,0,1,0" Padding="18,26">
      <!-- the entries scroll when the window is too short for all of them; settings and the plan card stay put -->
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,26">
          <Image Source="/Assets/icon_128.png" Width="30" Height="30" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Bold">
            <Run Text="System" /><Run Text="Boost" Foreground="{StaticResource SbOrange}" />
          </TextBlock>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,10,0,0">
          <Button x:Name="NavSettings" Classes="nav" Content="⚙   설정" />
          <Button x:Name="PlanCard" Classes="plancard" Cursor="Hand">
            <StackPanel Spacing="4">
              <TextBlock x:Name="PlanTitle" Text="무료" FontWeight="Bold" FontSize="14" />
              <TextBlock x:Name="PlanText" Classes="muted" Text="" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="NavPanel" Spacing="4" />
        </ScrollViewer>
      </DockPanel>
    </Border>
    <!-- page host + update bar (shown only when a downloaded update is ready) -->
    <DockPanel Grid.Column="1">
      <Border x:Name="UpdateBarBox" DockPanel.Dock="Top" IsVisible="False" Background="#2A1A0A" BorderBrush="#5A3A14" BorderThickness="0,0,0,1" Padding="20,10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button x:Name="UpdateNotes" Classes="ghost" Content="바뀐 점" />
            <Button x:Name="UpdateLater" Classes="ghost" Content="끌 때 적용" />
            <Button x:Name="UpdateRestart" Classes="primary" Content="지금 다시 시작" />
          </StackPanel>
          <TextBlock x:Name="UpdateBarText" VerticalAlignment="Center" Foreground="#FFC58A" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
      <!-- on every page, so nobody has to find Settings in a language they do not read -->
      <pages:LanguageBar DockPanel.Dock="Top" Margin="34,14,34,0" />
      <ContentControl x:Name="PageHost" Margin="34,10,34,28" />
    </DockPanel>
  </Grid>
</Window>
