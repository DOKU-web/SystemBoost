<Project Sdk="Microsoft.NET.Sdk">
  <!-- SystemBoost v0.6 - one UI for Windows and macOS (Avalonia). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SystemBoost</AssemblyName>
    <RootNamespace>SystemBoost.App</RootNamespace>
    <Version>0.8.6</Version>
    <Product>SystemBoost</Product>
    <Company>DOKKU</Company>
    <Authors>DOKKU</Authors>
    <Copyright>© 2026 DOKKU. All rights reserved.</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\brand\SystemBoost.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <!-- automatic updates; keep the same version as the vpk tool in build.yml -->
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets/wine-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\SystemBoost.ico" />
    <AvaloniaResource Include="Assets\icon_128.png" />
    <AvaloniaResource Include="Assets\eula.txt" />
  </ItemGroup>
</Project>
